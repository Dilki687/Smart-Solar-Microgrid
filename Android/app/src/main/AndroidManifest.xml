<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".SmartSolarApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.SmartSolarMicrogrid"
        tools:targetApi="31">
        <!-- Main application screen. -->
        <activity android:name=".ui.operator.OperatorDashboardActivity" android:exported="false" />
        <activity android:name=".ui.operator.OperatorProfileActivity" android:exported="false" />
        <activity android:name=".ui.operator.OperatorMapActivity" android:exported="false" />
        <activity android:name=".ui.operator.QrTransferActivity" android:exported="false" />
        <activity android:name=".ui.operator.OperatorAvailabilityActivity" android:exported="false" />
        <activity android:name=".ui.prosumer.ReservationQrActivity" android:exported="false" />
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="fullSensor"
            android:exported="false"
            tools:replace="android:screenOrientation" />
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <activity
            android:name=".ui.prosumer.ProsumerProfileActivity"
            android:exported="false" />

        <activity
            android:name=".ui.prosumer.ProsumerDashboardActivity"
            android:exported="false" />

        <activity
            android:name=".ui.prosumer.BookingActivity"
            android:exported="false" />

        <activity
            android:name=".ui.prosumer.MyReservationsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.prosumer.RequestUpdateActivity"
            android:exported="false" />

        <activity
            android:name=".ui.reservation.ReservationDetailsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.operator.OperatorReservationsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.backoffice.BackofficeDashboardActivity"
            android:exported="false" />

        <activity
            android:name=".ui.backoffice.UserManagementActivity"
            android:exported="false" />

        <activity
            android:name=".ui.backoffice.ProsumerLookupActivity"
            android:exported="false" />

        <activity
            android:name=".ui.backoffice.DeactivationRequestsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.backoffice.StationManagementActivity"
            android:exported="false" />

        <activity
            android:name=".ui.backoffice.BookingSlotManagementActivity"
            android:exported="false" />

        <!-- Authentication screen. -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
