<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:padding="20dp"
  android:background="@color/surface_background">
  <TextView
    android:id="@+id/tvOperatorName"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:text="@string/operator_dashboard"
    android:textColor="@color/text_primary"
    android:textSize="16sp"
    android:textStyle="bold" />
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">
    <LinearLayout
      android:layout_width="0dp"
      android:layout_weight="1"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:padding="10dp"
      android:background="@drawable/bg_stat_green">
      <TextView
        android:id="@+id/tvTodayCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/operator_count_loading"
        android:textColor="@color/text_primary"
        android:textSize="16sp" />
      <TextView
        android:id="@+id/tvUpcomingCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/operator_count_loading"
        android:textColor="@color/text_primary"
        android:textSize="16sp" />
    </LinearLayout>
    <LinearLayout
      android:layout_width="0dp"
      android:layout_weight="1"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:padding="10dp"
      android:background="@drawable/bg_stat_blue">
      <TextView
        android:id="@+id/tvPendingCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/operator_count_loading"
        android:textColor="@color/text_primary"
        android:textSize="16sp" />
      <TextView
        android:id="@+id/tvCompletedCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/operator_count_loading"
        android:textColor="@color/text_primary"
        android:textSize="16sp" />
    </LinearLayout>
  </LinearLayout>
  <com.google.android.material.button.MaterialButton
    android:id="@+id/btnScan"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="@string/operator_scan" />
  <com.google.android.material.button.MaterialButton
    android:id="@+id/btnAvailability"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="@string/operator_availability" />
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">
    <com.google.android.material.button.MaterialButton
      android:id="@+id/btnRefresh"
      android:layout_width="0dp"
      android:layout_weight="1"
      android:layout_height="wrap_content"
      android:text="@string/operator_refresh" />
    <com.google.android.material.button.MaterialButton
      android:id="@+id/btnOperatorLogout"
      android:layout_width="0dp"
      android:layout_weight="1"
      android:layout_height="wrap_content"
      android:text="@string/nav_logout" />
  </LinearLayout>
  <TextView
    android:id="@+id/tvJobsTitle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:text="@string/operator_jobs"
    android:textColor="@color/text_primary"
    android:textSize="16sp" />
  <ProgressBar
    android:id="@+id/operatorProgress"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal"
    android:visibility="gone" />
  <TextView
    android:id="@+id/tvOperatorMessage"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:text=""
    android:textColor="@color/text_primary"
    android:textSize="16sp"
    android:visibility="gone" />
  <androidx.recyclerview.widget.RecyclerView
    android:id="@+id/rvJobs"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1" />
</LinearLayout>