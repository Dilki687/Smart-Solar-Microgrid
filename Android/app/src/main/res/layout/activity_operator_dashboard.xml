<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:background="@color/surface_background">

  <ScrollView
    android:id="@+id/operatorDashboardScroll"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:fillViewport="true">
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:padding="20dp">

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
          android:layout_width="42dp"
          android:layout_height="42dp"
          android:gravity="center"
          android:text="☀"
          android:textColor="@color/tone_green_fg"
          android:textSize="27sp"
          android:background="@drawable/bg_badge_success" />
        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:layout_marginStart="12dp"
          android:orientation="vertical">
          <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Smart Solar Microgrid"
            android:textColor="@color/brand_navy"
            android:textSize="18sp"
            android:textStyle="bold" />
          <TextView
            android:id="@+id/tvGreeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Welcome, Grid Operator"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />
          <TextView
            android:id="@+id/tvOperatorName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />
        </LinearLayout>
        <ImageButton
          android:id="@+id/btnNotification"
          android:layout_width="44dp"
          android:layout_height="44dp"
          android:background="@android:color/transparent"
          android:contentDescription="Notifications"
          android:src="@drawable/ic_notification_bell"
          app:tint="@color/text_primary" />
      </LinearLayout>

      <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRefresh"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:text="Refresh"
        android:textColor="@color/tone_blue_fg" />

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">
        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="92dp"
          android:layout_marginEnd="6dp"
          android:layout_weight="1"
          android:orientation="vertical"
          android:padding="12dp"
          android:background="@drawable/bg_stat_blue">
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="▦" android:textColor="@color/tone_blue_fg" android:textSize="20sp" />
          <TextView android:id="@+id/tvTotalStations" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="@color/text_primary" android:textSize="22sp" android:textStyle="bold" />
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Total stations" android:textColor="@color/text_secondary" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="92dp"
          android:layout_marginStart="6dp"
          android:layout_weight="1"
          android:orientation="vertical"
          android:padding="12dp"
          android:background="@drawable/bg_stat_green">
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✓" android:textColor="@color/tone_green_fg" android:textSize="20sp" />
          <TextView android:id="@+id/tvActiveStations" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="@color/text_primary" android:textSize="22sp" android:textStyle="bold" />
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Active stations" android:textColor="@color/text_secondary" android:textSize="11sp" />
        </LinearLayout>
      </LinearLayout>
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">
        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="92dp"
          android:layout_marginEnd="6dp"
          android:layout_weight="1"
          android:orientation="vertical"
          android:padding="12dp"
          android:background="@drawable/bg_stat_amber">
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="!" android:textColor="@color/tone_amber_fg" android:textSize="20sp" />
          <TextView android:id="@+id/tvInactiveStations" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="@color/text_primary" android:textSize="22sp" android:textStyle="bold" />
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Inactive stations" android:textColor="@color/text_secondary" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="92dp"
          android:layout_marginStart="6dp"
          android:layout_weight="1"
          android:orientation="vertical"
          android:padding="12dp"
          android:background="@drawable/bg_stat_violet">
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⚡" android:textColor="@color/tone_violet_fg" android:textSize="20sp" />
          <TextView android:id="@+id/tvAvailableCapacity" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="@color/text_primary" android:textSize="22sp" android:textStyle="bold" />
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Available slot capacity" android:textColor="@color/text_secondary" android:textSize="11sp" />
        </LinearLayout>
      </LinearLayout>

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Quick Actions"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton
          android:id="@+id/btnNearbyStations"
          android:layout_width="0dp"
          android:layout_height="72dp"
          android:layout_marginEnd="5dp"
          android:layout_weight="1"
          android:text="Find nearby Stations"
          android:textAllCaps="false"
          android:textColor="@color/text_primary"
          android:textSize="12sp"
          android:backgroundTint="@color/surface_card"
          app:icon="@drawable/ic_nav_station"
          app:iconTint="@color/tone_blue_fg" />
      </LinearLayout>

      <ProgressBar android:id="@+id/operatorProgress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:visibility="gone" />
    </LinearLayout>
  </ScrollView>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="68dp"
    android:gravity="center"
    android:background="@color/surface_card"
    android:elevation="8dp">
    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="▦&#10;Dashboard" android:textColor="@color/tone_green_fg" android:textSize="11sp" android:textStyle="bold" />
    <TextView android:id="@+id/btnBottomScan" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="⌗&#10;Scan QR" android:textColor="@color/text_secondary" android:textSize="11sp" />
    <TextView android:id="@+id/btnBottomMap" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="⌖&#10;Map" android:textColor="@color/text_secondary" android:textSize="11sp" />
    <TextView android:id="@+id/btnOperatorLogout" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="♙&#10;Profile" android:textColor="@color/text_secondary" android:textSize="11sp" />
  </LinearLayout>
</LinearLayout>