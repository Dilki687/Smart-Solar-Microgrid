<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:background="@color/surface_background">

  <ScrollView
    android:id="@+id/operatorDashboardScroll"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:fillViewport="true">
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:padding="20dp">

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
          android:layout_width="42dp"
          android:layout_height="42dp"
          android:gravity="center"
          android:text="☀"
          android:textColor="@color/tone_green_fg"
          android:textSize="27sp"
          android:background="@drawable/bg_badge_success" />
        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:layout_marginStart="12dp"
          android:orientation="vertical">
          <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Smart Solar Microgrid"
            android:textColor="@color/brand_navy"
            android:textSize="18sp"
            android:textStyle="bold" />
          <TextView
            android:id="@+id/tvGreeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Welcome, Grid Operator"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />
          <TextView
            android:id="@+id/tvOperatorName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />
        </LinearLayout>
        <ImageButton
          android:id="@+id/btnNotification"
          android:layout_width="44dp"
          android:layout_height="44dp"
          android:background="@android:color/transparent"
          android:contentDescription="Notifications"
          android:src="@drawable/ic_notification_bell"
          app:tint="@color/text_primary" />
      </LinearLayout>

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center_vertical">
        <TextView
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text="Today’s Operations"
          android:textColor="@color/text_primary"
          android:textSize="20sp"
          android:textStyle="bold" />
        <com.google.android.material.button.MaterialButton
          android:id="@+id/btnRefresh"
          style="@style/Widget.Material3.Button.TextButton"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Refresh"
          android:textColor="@color/tone_blue_fg" />
      </LinearLayout>

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">
        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="92dp"
          android:layout_marginEnd="6dp"
          android:layout_weight="1"
          android:orientation="vertical"
          android:padding="12dp"
          android:background="@drawable/bg_stat_amber">
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="◷" android:textColor="@color/tone_amber_fg" android:textSize="20sp" />
          <TextView android:id="@+id/tvPendingCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="@color/text_primary" android:textSize="22sp" android:textStyle="bold" />
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pending transfers" android:textColor="@color/text_secondary" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="92dp"
          android:layout_marginStart="6dp"
          android:layout_weight="1"
          android:orientation="vertical"
          android:padding="12dp"
          android:background="@drawable/bg_stat_green">
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✓" android:textColor="@color/tone_green_fg" android:textSize="20sp" />
          <TextView android:id="@+id/tvCompletedCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="@color/text_primary" android:textSize="22sp" android:textStyle="bold" />
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Completed today" android:textColor="@color/text_secondary" android:textSize="11sp" />
        </LinearLayout>
      </LinearLayout>
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">
        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="92dp"
          android:layout_marginEnd="6dp"
          android:layout_weight="1"
          android:orientation="vertical"
          android:padding="12dp"
          android:background="@drawable/bg_stat_blue">
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="▣" android:textColor="@color/tone_blue_fg" android:textSize="20sp" />
          <TextView android:id="@+id/tvTodayCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="@color/text_primary" android:textSize="22sp" android:textStyle="bold" />
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Approved bookings" android:textColor="@color/text_secondary" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="92dp"
          android:layout_marginStart="6dp"
          android:layout_weight="1"
          android:orientation="vertical"
          android:padding="12dp"
          android:background="@drawable/bg_stat_violet">
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⌖" android:textColor="@color/tone_violet_fg" android:textSize="20sp" />
          <TextView android:id="@+id/tvNearbyCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="@color/text_primary" android:textSize="22sp" android:textStyle="bold" />
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Nearby stations" android:textColor="@color/text_secondary" android:textSize="11sp" />
        </LinearLayout>
      </LinearLayout>

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Quick Actions"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />
      <com.google.android.material.button.MaterialButton
        android:id="@+id/btnScan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:minHeight="72dp"
        android:gravity="center_vertical|start"
        android:paddingStart="20dp"
        android:text="Scan QR&#10;Verify prosumer transaction"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="@color/tone_green_fg"
        app:icon="@drawable/ic_nav_station"
        app:iconTint="@color/white"
        app:iconPadding="16dp" />
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton
          android:layout_width="0dp"
          android:layout_height="72dp"
          android:layout_marginEnd="5dp"
          android:layout_weight="1"
          android:text="Station Map&#10;Find nearby stations"
          android:textAllCaps="false"
          android:textColor="@color/text_primary"
          android:textSize="12sp"
          android:backgroundTint="@color/surface_card"
          app:icon="@drawable/ic_nav_station"
          app:iconTint="@color/tone_blue_fg" />
        <com.google.android.material.button.MaterialButton
          android:layout_width="0dp"
          android:layout_height="72dp"
          android:layout_marginStart="5dp"
          android:layout_weight="1"
          android:text="Bookings&#10;View reservations"
          android:textAllCaps="false"
          android:textColor="@color/text_primary"
          android:textSize="12sp"
          android:backgroundTint="@color/surface_card"
          app:icon="@drawable/ic_nav_list"
          app:iconTint="@color/tone_blue_fg" />
      </LinearLayout>

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="130dp"
        android:layout_marginTop="24dp"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/bg_card">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Station Map" android:textColor="@color/text_primary" android:textSize="17sp" android:textStyle="bold" />
        <TextView android:id="@+id/tvStationMapSummary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Active microgrid stations" android:textColor="@color/text_secondary" android:textSize="13sp" />
        <org.osmdroid.views.MapView
          android:id="@+id/operatorStationMap"
          android:layout_width="match_parent"
          android:layout_height="0dp"
          android:layout_weight="1"
          android:layout_marginTop="10dp"
          android:background="@color/tone_blue_bg" />
      </LinearLayout>

      <TextView
        android:id="@+id/tvJobsTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Recent Transactions"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />
      <ProgressBar android:id="@+id/operatorProgress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:visibility="gone" />
      <TextView android:id="@+id/tvOperatorMessage" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/text_secondary" android:textSize="14sp" android:visibility="gone" />
      <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvJobs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false"
        android:layout_marginTop="8dp" />
    </LinearLayout>
  </ScrollView>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="68dp"
    android:gravity="center"
    android:background="@color/surface_card"
    android:elevation="8dp">
    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="▦&#10;Dashboard" android:textColor="@color/tone_green_fg" android:textSize="11sp" android:textStyle="bold" />
    <TextView android:id="@+id/btnBottomScan" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="⌗&#10;Scan QR" android:textColor="@color/text_secondary" android:textSize="11sp" />
    <TextView android:id="@+id/btnBottomMap" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="⌖&#10;Map" android:textColor="@color/text_secondary" android:textSize="11sp" />
    <TextView android:id="@+id/btnBottomHistory" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="▤&#10;History" android:textColor="@color/text_secondary" android:textSize="11sp" />
    <TextView android:id="@+id/btnOperatorLogout" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="♙&#10;Profile" android:textColor="@color/text_secondary" android:textSize="11sp" />
  </LinearLayout>
</LinearLayout>