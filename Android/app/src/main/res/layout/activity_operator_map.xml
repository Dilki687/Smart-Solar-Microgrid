<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="@color/surface_card">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMapBack"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Back" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Station Map"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tvMapStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loading active stations..."
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMapRetry"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Refresh" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/mapProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:visibility="gone" />
    <org.osmdroid.views.MapView
        android:id="@+id/operatorFullMap"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>